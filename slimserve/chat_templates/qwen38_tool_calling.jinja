{#- Qwen3.8 native <think> + XML tool protocol. -#}
{%- set image_count = namespace(value=0) %}
{%- set video_count = namespace(value=0) %}
{%- macro render_content(content, do_vision_count, is_system_content=false) %}
    {%- if content is string %}
        {{- content }}
    {%- elif content is iterable and content is not mapping %}
        {%- for item in content %}
            {%- if 'image' in item or 'image_url' in item or item.type == 'image' %}
                {%- if is_system_content %}{{- raise_exception('System message cannot contain images.') }}{%- endif %}
                {%- if do_vision_count %}{%- set image_count.value = image_count.value + 1 %}{%- endif %}
                {%- if add_vision_id %}{{- 'Picture ' ~ image_count.value ~ ': ' }}{%- endif %}
                {{- '<|vision_start|><|image_pad|><|vision_end|>' }}
            {%- elif 'video' in item or item.type == 'video' %}
                {%- if is_system_content %}{{- raise_exception('System message cannot contain videos.') }}{%- endif %}
                {%- if do_vision_count %}{%- set video_count.value = video_count.value + 1 %}{%- endif %}
                {%- if add_vision_id %}{{- 'Video ' ~ video_count.value ~ ': ' }}{%- endif %}
                {{- '<|vision_start|><|video_pad|><|vision_end|>' }}
            {%- elif 'text' in item %}
                {{- item.text }}
            {%- else %}
                {{- raise_exception('Unexpected item type in content.') }}
            {%- endif %}
        {%- endfor %}
    {%- elif content is none or content is undefined %}
        {{- '' }}
    {%- else %}
        {{- raise_exception('Unexpected content type.') }}
    {%- endif %}
{%- endmacro %}
{%- macro tool_name(tool) -%}
    {%- if tool.function is defined -%}{{- tool.function.name -}}{%- else -%}{{- tool.name -}}{%- endif -%}
{%- endmacro %}
{%- if not messages %}{{- raise_exception('No messages provided.') }}{%- endif %}

{#- Keep effort as a prompt hint only. The server enforces its configured token budget. -#}
{%- set thinking_enabled = enable_thinking if enable_thinking is defined else true %}
{%- set resolved_reasoning_effort = reasoning_effort|default('xhigh') %}
{%- if resolved_reasoning_effort == 'high' %}{%- set resolved_reasoning_effort = 'xhigh' %}{%- endif %}
{%- if resolved_reasoning_effort == 'none' %}{%- set thinking_enabled = false %}{%- endif %}
{%- if resolved_reasoning_effort not in ('xhigh', 'medium', 'low', 'none') %}
    {{- raise_exception('Unexpected reasoning effort ' ~ reasoning_effort ~ '. Supported types are high/xhigh, medium, low, and none.') }}
{%- endif %}
{%- set reasoning_instructions = '' %}
{%- if thinking_enabled %}
    {%- if resolved_reasoning_effort == 'xhigh' %}
        {%- set reasoning_instructions = 'Reasoning effort is set to high. Think carefully, validate key assumptions, and finish within the available thinking budget.' %}
    {%- elif resolved_reasoning_effort == 'low' %}
        {%- set reasoning_instructions = 'Reasoning effort is set to low. Keep thinking brief and focused, and finish within the available thinking budget.' %}
    {%- else %}
        {%- set reasoning_instructions = 'Finish your reasoning within the available thinking budget.' %}
    {%- endif %}
{%- endif %}

{#- Normalize Chat Completions and Responses tool-choice shapes. -#}
{%- set choice = namespace(mode='auto', name=none) %}
{%- if tool_choice is defined and tool_choice is not none %}
    {%- if tool_choice is string %}
        {%- set choice.mode = tool_choice %}
    {%- elif tool_choice is mapping and tool_choice.type == 'allowed_tools' %}
        {%- set choice.mode = tool_choice.mode|default('auto') %}
    {%- elif tool_choice is mapping and tool_choice.type in ('function', 'custom') %}
        {%- set choice.mode = 'required' %}
        {%- if tool_choice.function is defined and tool_choice.function.name is defined %}
            {%- set choice.name = tool_choice.function.name %}
        {%- elif tool_choice.name is defined %}
            {%- set choice.name = tool_choice.name %}
        {%- endif %}
    {%- endif %}
{%- endif %}
{%- if choice.mode not in ('auto', 'required', 'none') %}
    {{- raise_exception('Unexpected tool choice mode ' ~ choice.mode ~ '.') }}
{%- endif %}

{%- if tools and tools is iterable and tools is not mapping %}
    {{- '<|im_start|>system\n' }}
    {%- if reasoning_instructions %}{{- reasoning_instructions + '\n\n' }}{%- endif %}
    {{- '# Tools\n\nYou have access to the following functions:\n\n<tools>' }}
    {%- for tool in tools %}{{- '\n' + (tool | tojson) }}{%- endfor %}
    {{- '\n</tools>' }}
    {{- '\n\nA function call must use exactly this XML envelope, with no suffix:\n\n<tool_call>\n<function=example_function_name>\n<parameter=example_parameter_1>\nvalue_1\n</parameter>\n</function>\n</tool_call>\n\nThe function name must be provided above. Include every required parameter. Arguments must satisfy the function JSON schema; when strict is true, do not add undeclared parameters. Emit each parallel call in its own <tool_call> block. Never invent or emit a tool result yourself.' }}
    {%- if choice.mode == 'required' and choice.name %}
        {{- '\n\nYou must call the function ' + choice.name + '. After optional reasoning inside <think>...</think>, emit only that tool call, with no ordinary text before or after it.' }}
    {%- elif choice.mode == 'required' %}
        {{- '\n\nYou must call at least one provided function. After optional reasoning inside <think>...</think>, emit only tool calls, with no ordinary text before or after them.' }}
    {%- elif choice.mode == 'none' %}
        {{- '\n\nDo not call any function. Answer with ordinary text.' }}
    {%- else %}
        {{- '\n\nChoose between an ordinary answer and function calls according to the user request. If calling functions, optional reasoning may appear inside <think>...</think>, but ordinary text must not appear after a tool call.' }}
    {%- endif %}
    {%- if messages[0].role == 'system' %}
        {%- set content = render_content(messages[0].content, false, true)|trim %}
        {%- if content %}{{- '\n\n' + content }}{%- endif %}
    {%- endif %}
    {{- '<|im_end|>\n' }}
{%- else %}
    {%- if messages[0].role == 'system' %}
        {%- set content = render_content(messages[0].content, false, true)|trim %}
        {%- if content %}{{- '<|im_start|>system\n' + (reasoning_instructions + '\n\n' if reasoning_instructions else '') + content + '<|im_end|>\n' }}
        {%- elif reasoning_instructions %}{{- '<|im_start|>system\n' + reasoning_instructions + '<|im_end|>\n' }}{%- endif %}
    {%- elif reasoning_instructions %}
        {{- '<|im_start|>system\n' + reasoning_instructions + '<|im_end|>\n' }}
    {%- endif %}
{%- endif %}

{%- set ns = namespace(found_query=false, last_query_index=messages|length - 1) %}
{%- for message in messages[::-1] %}
    {%- set index = (messages|length - 1) - loop.index0 %}
    {%- if not ns.found_query and message.role == 'user' %}
        {%- set ns.found_query = true %}
        {%- set ns.last_query_index = index %}
    {%- endif %}
{%- endfor %}
{%- if not ns.found_query %}{{- raise_exception('No user query found in messages.') }}{%- endif %}

{%- for message in messages %}
    {%- set content = render_content(message.content, true)|trim %}
    {%- if message.role == 'system' %}
        {%- if not loop.first %}{{- raise_exception('System message must be at the beginning.') }}{%- endif %}
    {%- elif message.role == 'user' %}
        {{- '<|im_start|>user\n' + content + '<|im_end|>\n' }}
    {%- elif message.role == 'assistant' %}
        {%- set reasoning_content = message.reasoning_content if message.reasoning_content is string else (message.reasoning if message.reasoning is string else '') %}
        {%- set reasoning_content = reasoning_content|trim %}
        {%- if preserve_thinking is undefined or preserve_thinking is true or loop.index0 > ns.last_query_index %}
            {{- '<|im_start|>assistant\n<think>\n' + reasoning_content + '\n</think>\n\n' + content }}
        {%- else %}
            {{- '<|im_start|>assistant\n' + content }}
        {%- endif %}
        {%- if message.tool_calls and message.tool_calls is iterable and message.tool_calls is not mapping %}
            {%- for call in message.tool_calls %}
                {%- set fn = call.function if call.function is defined else call %}
                {{- ('\n\n' if content|trim and loop.first else '\n' if not loop.first else '') + '<tool_call>\n<function=' + fn.name + '>\n' }}
                {%- if fn.arguments is mapping %}
                    {%- for arg_name, arg_value in fn.arguments|items %}
                        {{- '<parameter=' + arg_name + '>\n' + (arg_value if arg_value is string else arg_value|tojson) + '\n</parameter>\n' }}
                    {%- endfor %}
                {%- elif fn.arguments %}
                    {{- raise_exception('Qwen3 XML history requires tool-call arguments as an object, not a JSON string.') }}
                {%- endif %}
                {{- '</function>\n</tool_call>' }}
            {%- endfor %}
        {%- endif %}
        {{- '<|im_end|>\n' }}
    {%- elif message.role == 'tool' %}
        {%- if (loop.first or loop.previtem.role != 'tool') and (loop.first or loop.previtem.role != 'assistant' or not loop.previtem.tool_calls) %}
            {{- raise_exception('A tool result must immediately follow an assistant tool-call turn.') }}
        {%- endif %}
        {%- if loop.previtem and loop.previtem.role != 'tool' %}{{- '<|im_start|>user' }}{%- endif %}
        {{- '\n<tool_response>\n' + content + '\n</tool_response>' }}
        {%- if loop.last or loop.nextitem.role != 'tool' %}{{- '<|im_end|>\n' }}{%- endif %}
    {%- else %}
        {{- raise_exception('Unexpected message role.') }}
    {%- endif %}
{%- endfor %}
{%- if add_generation_prompt %}
    {{- '<|im_start|>assistant\n' }}
    {%- if not thinking_enabled %}{{- '<think>\n\n</think>\n\n' }}{%- else %}{{- '<think>\n' }}{%- endif %}
{%- endif %}
