# User service: adapt checkout/cache paths and GPU ordinals before installation.
# Assumes dependencies/native XPU libraries are installed in ~/SlimServe/.venv.
# For the existing public-8000 proxy, change ExecStart to host127.0.0.1 port8001.
[Unit]
Description=SlimServe Qwen3.8 native FP8 on four Intel Arc Pro B70 cards
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/SlimServe
Environment=SLIMSERVE_CACHE=%h/models
Environment=ZE_AFFINITY_MASK=0,1,2,3
# Kernel, replay, attention segment, and thinking defaults belong to the profile.
# Keep oneAPI compiler setup and private credentials out of this shared example.
ExecStart=%h/SlimServe/.venv/bin/python -m slimserve.cli qwen38-abliterated-b70-4 --serve --host 0.0.0.0 --port 8000 --yes
Restart=on-failure
RestartSec=60s
TimeoutStopSec=180s

[Install]
WantedBy=default.target
